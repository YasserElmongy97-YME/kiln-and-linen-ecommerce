# PostgreSQL connection string
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# Payments: only "sandbox" is implemented. Any other value stops the app at startup.
PAYMENT_PROVIDER=sandbox

# HMAC secret used to sign and verify payment webhooks (generate: openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=change-me-generate-a-long-random-value

# Public base URL, used for the same-origin check on state-changing requests
APP_URL=http://localhost:3000

# Used only by `npm run admin:create` (never committed, never seeded)
ADMIN_EMAIL=
ADMIN_PASSWORD=
